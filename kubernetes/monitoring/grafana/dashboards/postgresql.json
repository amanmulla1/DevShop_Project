{
  "title": "DevShop PostgreSQL",
  "uid": "devshop-postgresql",
  "version": 1,
  "schemaVersion": 40,
  "tags": ["devshop", "postgresql", "database"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Database Status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL UP/DOWN",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"postgres-exporter\"}", "legendFormat": "status", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ]
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_database_numbackends", "legendFormat": "conn", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Connection Utilisation %",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_database_numbackends / (pg_settings_max_connections / 1) * 100", "legendFormat": "%", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Database Size",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_database_size_bytes", "legendFormat": "size", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cache Hit Ratio %",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read)) * 100", "legendFormat": "%", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Transactions & Tuples",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Transactions / sec (commits + rollbacks)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "commit/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback[5m])", "legendFormat": "rollback/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tuples Read / Written / Returned",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_returned[5m])", "legendFormat": "returned/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_fetched[5m])", "legendFormat": "fetched/s", "refId": "B" },
        { "expr": "rate(pg_stat_database_tup_inserted[5m])", "legendFormat": "inserted/s", "refId": "C" },
        { "expr": "rate(pg_stat_database_tup_updated[5m])", "legendFormat": "updated/s", "refId": "D" },
        { "expr": "rate(pg_stat_database_tup_deleted[5m])", "legendFormat": "deleted/s", "refId": "E" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Locks & Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Active Backends / Max Connections",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_database_numbackends", "legendFormat": "active", "refId": "A" },
        { "expr": "pg_settings_max_connections", "legendFormat": "max", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Deadlocks & Locks Blocked",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_deadlocks_total", "legendFormat": "deadlocks", "refId": "A" },
        { "expr": "pg_locks_count", "legendFormat": "locks", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 } ] } }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Replication (disabled for single instance - informational)",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_replication_count", "legendFormat": "replicas (expected 0)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }
    }
  ]
}
