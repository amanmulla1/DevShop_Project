{
  "title": "DevShop Kubernetes Cluster Overview",
  "uid": "devshop-kubernetes",
  "version": 1,
  "schemaVersion": 40,
  "tags": ["devshop", "kubernetes"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(node_uname_info, instance)",
        "refresh": 1,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Nodes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes Ready",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "legendFormat": "ready", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodes NotReady",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0)", "legendFormat": "notready", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Allocatable CPU (cores)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(kube_node_status_allocatable{resource=\"cpu\"})", "legendFormat": "cpu", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Allocatable Memory (GiB)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(kube_node_status_allocatable{resource=\"memory\"}) / 1073741824", "legendFormat": "GiB", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "deckbytes", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Cluster Workloads",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total Pods",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_pod_info)", "legendFormat": "pods", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Running",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_pod_status_phase{phase=\"Running\"})", "legendFormat": "running", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Pending",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_pod_status_phase{phase=\"Pending\"})", "legendFormat": "pending", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Failed",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_pod_status_phase{phase=\"Failed\"})", "legendFormat": "failed", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Namespaces",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_namespace_status_phase{phase=\"Active\"})", "legendFormat": "ns", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Deployments",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "count(kube_deployment_spec_replicas)", "legendFormat": "deps", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Resource Utilisation (cAdvisor / cluster)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cluster CPU Utilisation %",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{image!=\"\",container!=\"\"}[5m])) / sum(machine_cpu_cores) * 100", "legendFormat": "CPU %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Cluster Memory Utilisation %",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{image!=\"\",container!=\"\"}) / sum(machine_memory_bytes) * 100", "legendFormat": "Mem %", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Requested vs Capacity CPU",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"})", "legendFormat": "requested", "refId": "A" },
        { "expr": "sum(kube_node_status_allocatable{resource=\"cpu\"})", "legendFormat": "capacity", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Unavailable / Desired Replicas by Deployment",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "kube_deployment_status_replicas_available - kube_deployment_spec_replicas", "legendFormat": "unavailable", "refId": "A", "format": "table", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] },
          "custom": { "align": "auto", "filterable": false }
        },
        "overrides": []
      },
      "transformations": []
    },
    {
      "id": 18,
      "type": "table",
      "title": "Pod Status by Namespace",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (namespace, phase) (kube_pod_status_phase)", "legendFormat": "{{namespace}} {{phase}}", "refId": "A", "format": "table", "instant": true }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "filterable": false } }, "overrides": [] },
      "transformations": []
    }
  ]
}
