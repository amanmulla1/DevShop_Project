# =============================================================================
# DevShop Docker Compose - Environment Variables (copy to .env and fill in)
#   cp .env.example .env
# IMPORTANT: Never commit the real .env file with real secrets.
# =============================================================================

# --- PostgreSQL ---
DB_NAME=devshop
DB_USERNAME=devshop
DB_PASSWORD=<CHANGE_ME_PASSWORD>

# --- Backend ---
# JWT signing secret. MUST be at least 32 bytes/characters.
JWT_SECRET=<CHANGE_ME_AT_LEAST_32_CHARS_JWT_SECRET>

# CORS origins allowed to call the backend API.
# Keep localhost:5173 / localhost:5174 (customer / admin frontends).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Initial admin account created on backend startup.
ADMIN_EMAIL=admin@devshop.com
ADMIN_PASSWORD=<CHANGE_ME_ADMIN_PASSWORD>
ADMIN_NAME=DevShop Admin

# --- Frontends (optional overrides) ---
# VITE_API_BASE_URL baked into the static bundle at build time. The browser
# runs OUTSIDE Docker, so this must be a browser-reachable address
# (http://localhost:8080 for local Docker development). Only change if you
# expose the backend on a different host/port.
# CUSTOMER_API_BASE_URL=http://localhost:8080
# ADMIN_API_BASE_URL=http://localhost:8080
