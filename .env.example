# =============================================================================
# DevShop Docker Compose - Environment Variables (copy to .env and fill in)
#   cp .env.example .env
# IMPORTANT: Never commit the real .env file with real secrets.
# =============================================================================

# --- PostgreSQL ---
DB_NAME=devshop
DB_USERNAME=devshop
DB_PASSWORD=<CHANGE_ME_PASSWORD>

# --- Backend ---
# JWT signing secret. MUST be at least 32 bytes/characters.
JWT_SECRET=<CHANGE_ME_AT_LEAST_32_CHARS_JWT_SECRET>

# CORS origins allowed to call the backend API.
# Local dev: keep localhost:5173 / localhost:5174 (customer / admin frontends).
# Production: such as when the same-origin frontends are served via Nginx
# (e.g. http://<server>:5173 / :5174), the browser still sends an Origin header.
# Add the deployed origins here so requests are not rejected with 403:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://<server>:5173,http://<server>:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Initial admin account created on backend startup.
ADMIN_EMAIL=admin@ds.com
ADMIN_PASSWORD=<CHANGE_ME_ADMIN_PASSWORD>
ADMIN_NAME=DevShop Admin

# --- Frontends ---
# No frontend API URL is required. The browser calls relative /api URLs on the
# same origin (:5173 / :5174), and each frontend's Nginx reverse-proxies /api/*
# to the backend over the Docker network (backend:8080). This works on
# localhost, any EC2 IP, or a domain without rebuild.
