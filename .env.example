# =============================================================================
# DevShop Docker Compose - Environment Variables (copy to .env and fill in)
#   cp .env.example .env
# IMPORTANT: Never commit the real .env file with real secrets.
# =============================================================================

# --- Server ---
# Public address (IP or domain) the app is served from. Used to build the
# browser-facing origins the backend allows via CORS:
#   http://${SERVER_IP}:5173  (customer)
#   http://${SERVER_IP}:5174  (admin)
# Local dev: localhost.  AWS: your EC2 public IP or domain. Change only .env.
SERVER_IP=localhost

# --- PostgreSQL ---
DB_NAME=devshop
DB_USERNAME=devshop
DB_PASSWORD=your_secure_password_here

# --- Backend ---
# JWT signing secret. MUST be at least 32 bytes/characters.
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# CORS origins are built from SERVER_IP in docker-compose.yml:
#   http://${SERVER_IP}:5173,http://${SERVER_IP}:5174
# (You may override the full list via CORS_ALLOWED_ORIGINS if needed.)
CORS_ALLOWED_ORIGINS=

# Initial admin account created on backend startup.
ADMIN_EMAIL=admin@devshop.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Admin

# --- Frontends ---
# No frontend API URL is required. The browser calls relative /api URLs on the
# same origin (:5173 / :5174), and each frontend's Nginx reverse-proxies /api/*
# to the backend over the Docker network (backend:8080). This works on
# localhost, any EC2 IP, or a domain without rebuild.
