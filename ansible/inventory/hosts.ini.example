# DevShop - Ansible inventory example.
#
# The real inventory is generated by scripts/generate_inventory.sh from the
# Terraform outputs (control_plane_public_ips / worker_public_ips). Do not
# hand-edit it; the public IPv4s change on stop/start (no Elastic IP).
#
# Two groups:
#   [control_plane] - kubeadm control-plane node(s) + Argo CD
#   [workers]       - app/monitoring workers. worker 0 hosts the application
#                     (frontends, backend, PostgreSQL); later workers host the
#                     monitoring stack. Set node_role accordingly.
#
# Ansible needs the private IP of the control plane so workers can join over
# the private subnet (kubeadm join endpoint).

[control_plane]
devshop-cp ansible_host=CHANGE_ME_CP_PUBLIC_IP node_role=control-plane

[workers]
devshop-worker-1 ansible_host=CHANGE_ME_WORKER1_PUBLIC_IP ansible_control_plane_private_ip=CHANGE_ME_CP_PRIVATE_IP node_role=app
devshop-worker-2 ansible_host=CHANGE_ME_WORKER2_PUBLIC_IP ansible_control_plane_private_ip=CHANGE_ME_CP_PRIVATE_IP node_role=monitoring

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/devshop.pem