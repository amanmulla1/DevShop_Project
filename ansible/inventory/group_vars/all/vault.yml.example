# =============================================================================
# DevShop — Ansible Vault secrets (EXAMPLE / TEMPLATE).
#
# This file documents the REQUIRED keys for the encrypted vault. It is safe to
# commit because it contains placeholders only.
#
# To create the REAL encrypted vault (values only ever stored encrypted):
#
#   cd ansible
#   ansible-vault create inventory/group_vars/all/vault.yml \
#       --vault-id devshop@prompt
#
#   # paste the keys below with real values, save & exit
#
# To edit later:
#
#   ansible-vault edit inventory/group_vars/all/vault.yml --vault-id devshop@prompt
#
# The real file (inventory/group_vars/all/vault.yml) is git-ignored by
# ansible/.gitignore so its encrypted content is not committed by accident.
# NEVER put plaintext secrets in this repository.
# =============================================================================

# --- PostgreSQL ------------------------------------------------------------
db_name: devshop
db_username: devshop
db_password: CHANGE_ME_DB_PASSWORD

# --- Backend ---------------------------------------------------------------
# JWT signing secret — MUST be at least 32 characters.
jwt_secret: CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS

# Bootstrap admin account (created by the backend on first startup).
admin_email: admin@devshop.com
admin_password: CHANGE_ME_ADMIN_PASSWORD
admin_name: DevShop Admin
