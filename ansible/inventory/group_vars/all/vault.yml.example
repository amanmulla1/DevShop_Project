# =============================================================================
# DevShop — Secrets EXAMPLE / TEMPLATE.
#
# Phase 7 (recommended): the root ./deploy.sh generates these secrets ONCE into
# the git-ignored control-node store `.devshop/secrets.yml` (mode 0600) and
# passes them to Ansible with --extra-vars @<file>. They are REUSED on every
# subsequent run (no rotation) and never committed or printed.
#
# This file documents the REQUIRED keys so you know what is expected. If you
# prefer a pre-encrypted vault instead of the generated store, create:
#
#   cd ansible
#   ansible-vault create inventory/group_vars/all/vault.yml \
#       --vault-id devshop@prompt
#
#   # paste the keys below with real values, save & exit
#
# The real file (inventory/group_vars/all/vault.yml) is git-ignored by
# ansible/.gitignore so its encrypted content is not committed by accident.
# NEVER put plaintext secrets in this repository.
# =============================================================================

# --- PostgreSQL ------------------------------------------------------------
db_name: devshop
db_username: devshop
db_password: CHANGE_ME_DB_PASSWORD

# --- Backend ---------------------------------------------------------------
# JWT signing secret — MUST be at least 32 characters.
jwt_secret: CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS

# Bootstrap admin account (created by the backend on first startup).
admin_email: admin@devshop.com
admin_password: CHANGE_ME_ADMIN_PASSWORD
admin_name: DevShop Admin
