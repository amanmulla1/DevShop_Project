# =============================================================================
# DevShop — generated deployment .env (on the EC2 host at {{ devshop_dir }}/.env)
# Templated by Ansible. Secret values originate from the encrypted Ansible Vault.
# SERVER_IP is auto-detected at deploy time; CORS origins are derived from it by
# docker-compose.yml (empty CORS_ALLOWED_ORIGINS => derived from SERVER_IP).
# This file is git-ignored and never committed.
# =============================================================================

SERVER_IP={{ devshop_public_ip }}

DB_NAME={{ db_name }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}

JWT_SECRET={{ jwt_secret }}

CORS_ALLOWED_ORIGINS={{ cors_allowed_origins | default('') }}

ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ admin_password }}
ADMIN_NAME={{ admin_name }}
