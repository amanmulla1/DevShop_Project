# =============================================================================
# DevShop - postgres-exporter Secret (rendered by Ansible OUTSIDE Argo CD)
#
# Holds the PostgreSQL DSN (which contains the DB password) that the exporter
# connects with. Rendered from the deploy.sh-generated secret store plus the
# group_vars db_username, so no password is ever committed or printed. Argo CD
# does not manage this Secret (not in the kustomize output), so it is never
# pruned.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: postgres-exporter-secret
  namespace: {{ monitoring_namespace }}
type: Opaque
stringData:
  DATA_SOURCE_NAME: "postgresql://{{ db_username }}:{{ db_password }}@postgres.{{ k8s_devshop_namespace }}:5432/{{ db_name }}?sslmode=disable"
