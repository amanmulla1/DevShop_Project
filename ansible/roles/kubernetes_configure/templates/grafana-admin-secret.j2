# =============================================================================
# DevShop - Grafana admin Secret (rendered by Ansible OUTSIDE Argo CD)
#
# The Grafana admin credentials are generated by deploy.sh and stored in the
# git-ignored .devshop/secrets.yml store, then surfaced here as environment
# variables on the Grafana pod. admin/admin is never used; the password is
# auto-generated and never printed/committed. Argo CD does not manage this
# Secret (it is not in the kustomize output), so it is never pruned.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-secret
  namespace: {{ monitoring_namespace }}
type: Opaque
stringData:
  GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
  GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
