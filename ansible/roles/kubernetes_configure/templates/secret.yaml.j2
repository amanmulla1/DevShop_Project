# =============================================================================
# DevShop — rendered devshop-secret (GENERATED BY ANSIBLE)
#
# This file is produced on the EC2 host at
#   {{ devshop_dir }}/kubernetes/overlays/aws/secret.yaml
# from secrets supplied by deploy.sh (control-node store) / persisted on the
# host. It is applied OUTSIDE Argo CD and never committed to Git.
#
# no_log is set on the render/apply tasks so values never appear in output.
# JWT_SECRET must be >= 32 characters (enforced during generation).
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: devshop-secret
  namespace: {{ k8s_devshop_namespace }}
  labels:
    app.kubernetes.io/part-of: devshop
type: Opaque
data:
  DB_USERNAME: "{{ db_username | b64encode }}"
  DB_PASSWORD: "{{ db_password | b64encode }}"
  JWT_SECRET:  "{{ jwt_secret | b64encode }}"
  ADMIN_PASSWORD: "{{ admin_password | b64encode }}"
