# =============================================================================
# DevShop - Kiali admin credentials (rendered OUTSIDE Git by Ansible)
#
# Values come from the root ./deploy.sh -> .devshop/secrets.yml (kiali_admin_user /
# kiali_admin_password) and are passed with --extra-vars. This file is written
# with mode 0600 to kubernetes/istio/addons/kiali/secret.yaml and is git-ignored.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: kiali
  namespace: istio-system
  labels:
    app: kiali
    app.kubernetes.io/part-of: devshop
type: Opaque
data:
  username: {{ kiali_admin_user | b64encode }}
  passphrase: {{ kiali_admin_password | b64encode }}