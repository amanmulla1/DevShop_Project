# Ansible — local/generated artifacts. Do NOT commit.

# Generated inventory (contains the EC2 public IP, which is not a secret but is
# environment-specific). Use inventory/hosts.ini.example to see the format.
inventory/hosts.ini

# Real (encrypted) vault file and any plaintext that must never be committed.
inventory/group_vars/all/vault.yml
vault/*.yml
!vault/README.md

# Ansible retry files.
*.retry

# Private SSH keys and secrets.
*.pem
*.key
