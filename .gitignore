# Environment / secrets - DO NOT COMMIT
.env
.env.*
!.env.example
# The Ansible .env template is a committed source file (Jinja placeholders only,
# no secrets) - un-ignore it.
!**/.env.j2

# Ansible — generated inventory (contains the EC2 public IP) and encrypted vault
ansible/inventory/hosts.ini
ansible/inventory/group_vars/all/vault.yml
ansible/vault/*.yml
*.retry

# Secrets / keys
*.pem
*.key

# Node dependencies (all), build outputs
node_modules/
dist/

# Backend build output
application/backend/target/
*.class

# Logs
*.log

# IDE / editor
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.swp
*~

# Internal development / session files (never publish)
PROJECT_STATUS.md
PROJECT_SPEC.md
CLAUDE.md
FINAL_VERIFICATION_REPORT.md
FRONTEND_SPLIT_COMPLETION.md
POSTGRESQL_VERIFICATION_COMPLETE.md
RUNNING_APPLICATIONS.md
SCHEMA_MIGRATION_REPORT.md
run_all_tests.bat
verify_api.ps1

# Stray npm files inside the Maven backend (not part of the project)
application/backend/package.json
application/backend/package-lock.json
