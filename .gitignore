# Environment / secrets - DO NOT COMMIT
.env
.env.*
!.env.example

# Keys / certs
*.pem
*.key

# Ansible - generated inventory (contains EC2 IP) and encrypted vault
ansible/inventory/hosts.ini
ansible/inventory/group_vars/all/vault.yml
ansible/vault/*.yml
*.retry

# Kubernetes - real secrets (only *.example.yaml templates commit)
kubernetes/base/secret.yaml
kubernetes/overlays/aws/secret.yaml
kubernetes/monitoring/grafana/secret.yaml
kubernetes/monitoring/postgres-exporter/secret.yaml

# Terraform state / plans
*.tfstate
*.tfstate.*
.terraform/
*.tfplan
!terraform/.terraform.lock.hcl

# Node / build
node_modules/
dist/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.log