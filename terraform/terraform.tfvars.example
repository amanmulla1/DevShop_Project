# =============================================================================
# DevShop — terraform.tfvars (example).
#
# Copy this file to terraform.tfvars, fill in YOUR values, and NEVER commit
# terraform.tfvars. It may contain your public IP and non-secret choices, but
# it must NEVER contain AWS access keys, secret keys, .pem files, DB passwords,
# or JWT secrets.
#
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

aws_region            = "ap-south-1"
project_name          = "devshop"
environment           = "dev"

vpc_cidr              = "10.0.0.0/16"
public_subnet_cidr    = "10.0.1.0/24"
availability_zone     = "ap-south-1a"

instance_type         = "t3.small"
root_volume_size_gb   = 20

# Name of a key pair that ALREADY exists in the region above.
# Create it in the AWS console or:  aws ec2 create-key-pair --key-name devshop-key
# You keep the resulting .pem locally; never commit it.
key_pair_name         = "devshop-key"

# Your current public IP, e.g. "203.0.113.5/32" — used for SSH (port 22).
# Find it with:  curl -s ifconfig.me
admin_cidr            = "YOUR_PUBLIC_IP/32"

# Optional explicit AMI id. Leave empty to auto-select the latest Ubuntu 24.04
# LTS AMI for the configured region.
# ami_id              = "ami-0abc1234def567890"

# Application-port exposure (documented in security.tf):
# - customer storefront (5173) and admin dashboard (5174) default to public.
# - backend /api (8080) defaults to public for parity; prefer restricting to
#   the admin CIDR since the frontends proxy /api through Nginx.
# - PostgreSQL (5432) is NOT opened by default (lives inside the Docker network
#   on the host). Leave postgres_ingress_cidrs empty unless you must connect.
# customer_ingress_cidrs = ["0.0.0.0/0"]
# admin_ingress_cidrs    = ["0.0.0.0/0"]
# backend_ingress_cidrs  = ["0.0.0.0/0"]
# postgres_ingress_cidrs = []
